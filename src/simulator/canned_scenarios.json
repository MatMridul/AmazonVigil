      "subject": "FAMILY",
      "host_state": "H_asleep",
      "mode": "night_sentry",
      "score": 0.05,
      "signals": {"motion_indicator": true, "visual_indicator": true, "acoustic_indicator": true},
      "expected_level": "L0_SAFE",
      "expected_action": "SILENT_PASS",
      "expected_actuators_empty": true,
      "expected_cad_staged": false
    },
